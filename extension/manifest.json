{
  "manifest_version": 3,
  "name": "Claude Counter",
  "version": "0.4.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "{236c6889-52b6-4454-bc4b-5a2ad18effa2}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "Shows ~token count, cache timer, and native session/weekly usage bars on claude.ai.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "96": "assets/icon96.png",
    "128": "assets/icon128.png",
    "256": "assets/icon256.png"
  },
  "action": {
    "default_title": "Claude Counter",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "96": "assets/icon96.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content/constants.js",
        "content/bridge-client.js",
        "vendor/o200k_base.js",
        "content/tokens.js",
        "content/ui.js",
        "content/main.js"
      ]
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Toggle the visibility of the token counter overlay"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected/bridge.js"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ]
}