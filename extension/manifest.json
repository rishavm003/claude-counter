{
  "manifest_version": 3,
  "name": "Claude Counter",
  "short_name": "Claude Counter",
  "version": "1.0.0",
  "description": "Real session and weekly usage limits, plan, and an estimated token count for claude.ai. For Chrome, Edge and Brave.",
  "author": "rishavm003",
  "homepage_url": "https://github.com/rishavm003/claude-counter",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "action": {
    "default_title": "Claude Counter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/page/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/content/constants.js",
        "src/content/bridge-client.js",
        "src/content/tokens.js",
        "src/content/ui.js",
        "src/content/main.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Toggle the visibility of the token counter overlay"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/page/page-bridge.js"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ]
}
